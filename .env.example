# WhatsApp Cloud API (Meta) — server-only secrets
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=netops_verify_change_me
# Optional but recommended in production (validates X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_DEFAULT_DEPARTMENT_SLUG=soporte

# n8n — API forwards normalized inbound messages here (fire-and-forget + retries)
N8N_INBOUND_WEBHOOK_URL=
N8N_WEBHOOK_MAX_ATTEMPTS=3
N8N_WEBHOOK_TIMEOUT_MS=8000
